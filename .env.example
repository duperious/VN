# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e gönderilmez.

# Giriş bilgileri
AUTH_USERNAME=kullanici_adiniz

# bcrypt hash üretmek için:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'SIFRENIZ', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=

# Token imzalama anahtarı. Tanımlanmazsa her açılışta rastgele üretilir ve
# sunucu yeniden başladığında tüm oturumlar düşer.
# Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Arayüz API ile aynı adresten sunulduğunda BOŞ bırakın — normal kurulumda
# gerekmez. Yalnızca arayüz ayrı bir adreste barındırılacaksa doldurun.
# Virgülle ayırın: ALLOWED_ORIGINS=https://vizit.ornek.com,https://ikinci.ornek.com
ALLOWED_ORIGINS=

# Veritabanı dosyasının yolu. Tanımlanmazsa backend/vizit.db kullanılır.
# Dağıtımda kalıcı bir diske işaret etmelidir, aksi halde her yeniden
# dağıtımda veri kaybolur.
DB_PATH=
